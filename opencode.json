{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "provider": {
    "opencode": {
      "options": { "apiKey": "{env:OPENCODE_API_KEY}" }
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      "CLAUDE.md": "ask",
      "agent-kit.conf": "ask",
      "opencode.json": "ask",
      ".opencode/*": "ask",
      ".claude/*": "ask",
      "_docs/specs.md": "ask",
      "_docs/agent-kit/*": "ask"
    },
    "bash": {
      "*": "ask",
      "make *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git push*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}